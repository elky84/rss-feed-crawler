<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>RSS Feed Crawler</title>
    <style>
        body { font-family: sans-serif; margin: 2rem; }
        label { display: inline-block; margin: 0 1rem .5rem 0; }
        input { margin-left: .3rem; }
        table { border-collapse: collapse; margin-top: 1rem; width: 100%; }
        td, th { border: 1px solid #ccc; padding: .3rem .5rem; text-align: left; }
        nav a { margin-right: 1rem; }
    </style>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script>
        window.copyText = async function (text) {
            if (navigator.clipboard && window.isSecureContext) {
                await navigator.clipboard.writeText(text);
                return;
            }
            // HTTP 등 비보안 컨텍스트에서는 clipboard API가 없어 fallback 사용
            const ta = document.createElement("textarea");
            ta.value = text;
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand("copy"); } finally { document.body.removeChild(ta); }
        };
    </script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
